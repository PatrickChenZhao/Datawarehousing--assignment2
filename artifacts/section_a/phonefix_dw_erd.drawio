          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="PK = primary key | FK = foreign key | UK = unique/alternate key | DD = degenerate dimension | MEASURE = numeric fact" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#404040;" vertex="1" parent="1">
