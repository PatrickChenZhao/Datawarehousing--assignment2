        <mxCell id="store_fact" value="1 to many" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeWidth=3;strokeColor=#70AD47;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="store" target="fact">
          <mxGeometry relative="1" as="geometry"/>
