  <diagram id="phonefix-star" name="PhoneFix STAR">
    <mxGraphModel dx="2200" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;PhoneFix Data Warehouse - Five-Table STAR Schema&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="550" y="20" width="1100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="grain" value="&lt;b&gt;Fact grain:&lt;/b&gt; one accessory sale line or repair-service line, for one product/service, one customer, one store and one date, within one source transaction." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fillColor=#EAF2F8;strokeColor=#5B9BD5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="530" y="80" width="1140" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="date" value="&lt;div style=&quot;text-align:center;font-size:20px;&quot;&gt;&lt;b&gt;PF_DATE_DIM&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; DATE_KEY : NUMBER(8)&lt;br&gt;&lt;b&gt;UK&lt;/b&gt; FULL_DATE : DATE&lt;br&gt;DAY_OF_MONTH : NUMBER(2)&lt;br&gt;DAY_NAME : VARCHAR2(9)&lt;br&gt;WEEK_OF_YEAR : NUMBER(2)&lt;br&gt;MONTH_NUMBER : NUMBER(2)&lt;br&gt;MONTH_NAME : VARCHAR2(9)&lt;br&gt;QUARTER_NUMBER : NUMBER(1)&lt;br&gt;CALENDAR_YEAR : NUMBER(4)&lt;br&gt;WEEKEND_FLAG : CHAR(1)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;fillColor=#DDEBF7;strokeColor=#4472C4;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="500" height="480" as="geometry"/>
        </mxCell>

        <mxCell id="store" value="&lt;div style=&quot;text-align:center;font-size:20px;&quot;&gt;&lt;b&gt;PF_STORE_DIM&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; STORE_KEY : NUMBER(10)&lt;br&gt;&lt;b&gt;UK&lt;/b&gt; STORE_ID : VARCHAR2(20)&lt;br&gt;STORE_NAME : VARCHAR2(100)&lt;br&gt;OWNER_NAME : VARCHAR2(100)&lt;br&gt;ADDRESS_LINE : VARCHAR2(200)&lt;br&gt;SUBURB : VARCHAR2(80)&lt;br&gt;CITY : VARCHAR2(80)&lt;br&gt;POSTCODE : VARCHAR2(10)&lt;br&gt;OPEN_DATE : DATE&lt;br&gt;STORE_STATUS : VARCHAR2(10)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1660" y="190" width="500" height="480" as="geometry"/>
        </mxCell>

        <mxCell id="customer" value="&lt;div style=&quot;text-align:center;font-size:20px;&quot;&gt;&lt;b&gt;PF_CUSTOMER_DIM&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; CUSTOMER_KEY : NUMBER(10)&lt;br&gt;&lt;b&gt;UK&lt;/b&gt; CUSTOMER_ID : VARCHAR2(30)&lt;br&gt;CUSTOMER_NAME : VARCHAR2(120)&lt;br&gt;ADDRESS_LINE : VARCHAR2(200)&lt;br&gt;SUBURB : VARCHAR2(80)&lt;br&gt;CITY : VARCHAR2(80)&lt;br&gt;DATE_OF_BIRTH : DATE&lt;br&gt;INCOME_RANGE : VARCHAR2(40)&lt;br&gt;OCCUPATION : VARCHAR2(100)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;fillColor=#E4DFEC;strokeColor=#8064A2;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="500" height="450" as="geometry"/>
        </mxCell>

        <mxCell id="product" value="&lt;div style=&quot;text-align:center;font-size:20px;&quot;&gt;&lt;b&gt;PF_PRODUCT_DIM&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; PRODUCT_KEY : NUMBER(10)&lt;br&gt;&lt;b&gt;UK&lt;/b&gt; PRODUCT_ID : VARCHAR2(30)&lt;br&gt;PRODUCT_NAME : VARCHAR2(120)&lt;br&gt;PRODUCT_TYPE : VARCHAR2(20)&lt;br&gt;CATEGORY_NAME : VARCHAR2(80)&lt;br&gt;BRAND_NAME : VARCHAR2(80)&lt;br&gt;MODEL_NAME : VARCHAR2(80)&lt;br&gt;SUPPLIER_ID : VARCHAR2(30)&lt;br&gt;SUPPLIER_NAME : VARCHAR2(120)&lt;br&gt;&lt;br&gt;&lt;b&gt;PRODUCT_TYPE&lt;/b&gt;: ACCESSORY or REPAIR_SERVICE" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1660" y="800" width="500" height="500" as="geometry"/>
        </mxCell>

        <mxCell id="fact" value="&lt;div style=&quot;text-align:center;font-size:22px;&quot;&gt;&lt;b&gt;PF_TRANSACTION_FACT&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; TRANSACTION_KEY : NUMBER(12)&lt;br&gt;&lt;b&gt;DD / UK&lt;/b&gt; SOURCE_TRANSACTION_ID : VARCHAR2(30)&lt;br&gt;&lt;b&gt;UK&lt;/b&gt; TRANSACTION_LINE_NO : NUMBER(4)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; DATE_KEY : NUMBER(8)&lt;br&gt;&lt;b&gt;FK / UK&lt;/b&gt; STORE_KEY : NUMBER(10)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; CUSTOMER_KEY : NUMBER(10)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; PRODUCT_KEY : NUMBER(10)&lt;br&gt;&lt;b&gt;MEASURE&lt;/b&gt; QUANTITY : NUMBER(10)&lt;br&gt;&lt;b&gt;MEASURE&lt;/b&gt; UNIT_SELLING_PRICE : NUMBER(12,2)&lt;br&gt;&lt;b&gt;MEASURE&lt;/b&gt; UNIT_COST : NUMBER(12,2)&lt;br&gt;&lt;b&gt;MEASURE&lt;/b&gt; SALES_AMOUNT : NUMBER(14,2)&lt;br&gt;&lt;b&gt;MEASURE&lt;/b&gt; COST_AMOUNT : NUMBER(14,2)&lt;br&gt;&lt;br&gt;&lt;b&gt;Alternate key:&lt;/b&gt;&lt;br&gt;(STORE_KEY, SOURCE_TRANSACTION_ID, TRANSACTION_LINE_NO)&lt;br&gt;&lt;br&gt;&lt;b&gt;Derived analysis:&lt;/b&gt;&lt;br&gt;Gross profit = SUM(SALES_AMOUNT) - SUM(COST_AMOUNT)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=17;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=4;" vertex="1" parent="1">
          <mxGeometry x="700" y="200" width="800" height="1100" as="geometry"/>
        </mxCell>

        <mxCell id="date_fact" value="1 to many" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeWidth=3;strokeColor=#4472C4;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="date" target="fact">
          <mxGeometry relative="1" as="geometry"/>
